# Copy to supabase/.env (not committed) for local Google sign-in, then restart the stack.
# Google Cloud → APIs & Services → Credentials → OAuth client ID → Web application,
# authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
