# Secrets for the Edge Functions. Locally: copy to supabase/functions/.env
# (not committed). Hosted: `npx supabase secrets set --env-file <file>`.

# Which vision model scans photos: any claude-* or gemini-* id,
# e.g. claude-haiku-5-5, claude-sonnet-5-5, gemini-3.1-flash-lite.
# (gemini-2.5-* is closed to new Gemini accounts.)
SCAN_MODEL=claude-haiku-5-5
# The key for that model's provider is required for real scans.
ANTHROPIC_API_KEY=
# Gemini: use a key from a project with billing on. On the free tier Google may
# use and have people review the photos (ai.google.dev/gemini-api/terms).
GEMINI_API_KEY=
# Optional (defaults shown).
SCAN_EFFORT=low
FREE_SCANS_FIRST_WEEK=3
FREE_SCANS_PER_DAY=1
# Stop scanning for everyone when the last 24 hours of AI cost reach this (USD). Empty = no cap.
SCAN_DAILY_BUDGET_USD=
