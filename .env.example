# Copy to .env.local (not committed) and fill in. Expo reads EXPO_PUBLIC_* at
# build time; restart Metro after changing them. Leave both empty to run the
# app without a backend (prototype mocks for scan and sign-in).

# Local stack (`npm run db:start`). The Android emulator reaches the Mac at 10.0.2.2;
# a real phone needs the Mac's LAN address. Get the key from `npx supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Staging / production: https://<project-ref>.supabase.co and that project's
# publishable key (sb_publishable_…). Never put a secret key in the app.
